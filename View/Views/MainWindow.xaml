<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:BaseballScoreView"
    Title="Main Window"
    Height="672" Width="840"
>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="ファイル(_F)">
        <MenuItem Header="新規作成(_N)" />
        <MenuItem Header="開く(_O) ..." />
        <Separator />
        <MenuItem Header="上書き保存(_S)" />
        <MenuItem Header="名前を付けて保存(_A) ..." />
        <Separator />
        <MenuItem Header="テキストを開く(_T) ..." />
        <MenuItem Header="テキストとしてエクスポート(_E) ..." />
        <Separator />
        <MenuItem Header="終了(_X)" />
      </MenuItem>
      <MenuItem Header="スコア(_S)">
        <MenuItem Header="編集(_E) ..." />
        <MenuItem Header="詳細(_D) ..." />
        <MenuItem Header="インポート(_I) ..." />
        <Separator />
        <MenuItem Header="設定の変更(_S) ..." />
        <Separator />
        <MenuItem Header="最新の情報に更新(_R) ..." />
      </MenuItem>
      <MenuItem Header="マジック(_M)">
        <MenuItem Header="優勝マジック(_V)" />
        <MenuItem Header="プレーオフマジック(_P)" />
        <Separator />
        <MenuItem Header="簡易計算で行う(_E)" />
        <Separator />
        <MenuItem Header="詳細表示(L) ..." />
      </MenuItem>
      <MenuItem Header="オプション(_O)">
        <MenuItem Header="フォント(F) ..." />
      </MenuItem>
    </Menu>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition  Height="Auto" />
        <RowDefinition  Height="*" />
      </Grid.RowDefinitions>

      <TabControl
          Grid.Row="0"
      >
        <TabControl.ItemTemplate>
          <DataTemplate>
            <TextBlock  Text="LeagueName" />
          </DataTemplate>
        </TabControl.ItemTemplate>
      </TabControl>

      <DataGrid
          Grid.Row="1"
          AutoGenerateColumns="True"
          CanUserAddRows="False"
          RowHeaderWidth="0"
      />
    </Grid>
  </DockPanel>

</Window>
